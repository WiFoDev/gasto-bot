SUPABASE_URL=
SUPABASE_KEY=
ANTHROPIC_API_KEY=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
PORT=3000
# Optional. Shared secret for GET/POST /cron/keep-alive. Leave empty to keep
# the endpoint closed; set it (and the matching GitHub secret) to enable the
# daily keep-alive ping.
CRON_SECRET=
# Optional (Phase 6, bank-email ingestion). Bearer secret for
# POST /inbound/bank-email — leave empty to keep the endpoint closed.
INBOUND_EMAIL_SECRET=
# Kapso phone number ID used to send bot-initiated WhatsApp messages.
KAPSO_PHONE_NUMBER_ID=
# Phone (E.164, e.g. +51999999999) of the user who receives auto-logged expenses.
BANK_EMAIL_USER_PHONE=
